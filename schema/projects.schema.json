{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Projects view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot",
    "projects"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "snapshot": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "purpose",
          "description",
          "owner",
          "repository",
          "resources"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "repository": {
            "type": [
              "string",
              "null"
            ]
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "canonical",
                "path",
                "private"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "canonical": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "private": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
