{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repositories view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot",
    "repositories"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "snapshot": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "canonical",
          "remote",
          "purpose",
          "description",
          "owner"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "canonical": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$"
          },
          "remote": {
            "type": "string",
            "pattern": "^git@github\\.com:.+\\.git$"
          },
          "purpose": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    }
  }
}
